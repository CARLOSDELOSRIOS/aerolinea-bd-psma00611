digraph ER {
  graph [rankdir=TB, nodesep=0.2, ranksep=0.4, splines=true, pad=0.2, fontname="Liberation Sans", labelloc=t, fontsize=14, label="Modelo lógico relacional - Flota y tripulación (3FN)"];
  node [shape=plaintext, fontname="Liberation Sans", fontsize=10];
  edge [fontname="Liberation Sans", fontsize=8.5, color="#52514e", fontcolor="#52514e", arrowsize=0.9, dir=both];
  MODELO_AVION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>MODELO_AVION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_modelo</B></TD></TR><TR><TD></TD><TD ALIGN="LEFT">fabricante</TD></TR><TR><TD></TD><TD ALIGN="LEFT">modelo</TD></TR><TR><TD></TD><TD ALIGN="LEFT">alcance_millas</TD></TR></TABLE>>];
  CONFIGURACION_ASIENTOS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>CONFIGURACION_ASIENTOS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_configuracion</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT">codigo_configuracion</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_modelo</TD></TR></TABLE>>];
  ASIENTO_CONFIGURACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>ASIENTO_CONFIGURACION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_configuracion</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>codigo_asiento</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">codigo_cabina</TD></TR><TR><TD></TD><TD ALIGN="LEFT">es_salida_emergencia</TD></TR></TABLE>>];
  AVION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>AVION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_avion</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT">matricula</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_configuracion</TD></TR><TR><TD></TD><TD ALIGN="LEFT">estado_operativo</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_aeropuerto_base</TD></TR></TABLE>>];
  EMPLEADO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>EMPLEADO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_empleado</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT">numero_empleado</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">codigo_cargo</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_localizacion_base</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_supervisor</TD></TR><TR><TD></TD><TD ALIGN="LEFT">fecha_contratacion</TD></TR><TR><TD></TD><TD ALIGN="LEFT">fecha_terminacion</TD></TR><TR><TD></TD><TD ALIGN="LEFT">salario_anual_usd</TD></TR></TABLE>>];
  CARGO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>CARGO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>codigo_cargo</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">codigo_departamento</TD></TR><TR><TD></TD><TD ALIGN="LEFT">categoria_tripulacion</TD></TR></TABLE>>];
  ASIGNACION_TRIPULACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>ASIGNACION_TRIPULACION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_vuelo</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_empleado</B></TD></TR><TR><TD></TD><TD ALIGN="LEFT">rol_vuelo</TD></TR></TABLE>>];
  VUELO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>VUELO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_vuelo</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_avion</TD></TR></TABLE>>];
  CABINA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>CABINA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>codigo_cabina</B></TD></TR></TABLE>>];
  AEROPUERTO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>AEROPUERTO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_localizacion</B></TD></TR></TABLE>>];
  LOCALIZACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>LOCALIZACION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_localizacion</B></TD></TR></TABLE>>];
  LOCALIZACION -> AEROPUERTO [arrowtail=teetee, arrowhead=teeodot];
  AVION -> VUELO [arrowtail=teeodot, arrowhead=crowodot];
  MODELO_AVION -> CONFIGURACION_ASIENTOS [arrowtail=teetee, arrowhead=crowodot];
  CONFIGURACION_ASIENTOS -> ASIENTO_CONFIGURACION [arrowtail=teetee, arrowhead=crowtee];
  CABINA -> ASIENTO_CONFIGURACION [arrowtail=teetee, arrowhead=crowodot];
  CONFIGURACION_ASIENTOS -> AVION [arrowtail=teetee, arrowhead=crowodot];
  AEROPUERTO -> AVION [arrowtail=teetee, arrowhead=crowodot];
  CARGO -> EMPLEADO [arrowtail=teetee, arrowhead=crowodot];
  LOCALIZACION -> EMPLEADO [arrowtail=teetee, arrowhead=crowodot];
  EMPLEADO -> EMPLEADO [arrowtail=teeodot, arrowhead=crowodot];
  VUELO -> ASIGNACION_TRIPULACION [arrowtail=teetee, arrowhead=crowodot];
  EMPLEADO -> ASIGNACION_TRIPULACION [arrowtail=teetee, arrowhead=crowodot];
}
