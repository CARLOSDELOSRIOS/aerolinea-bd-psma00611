digraph ER {
  graph [rankdir=TB, nodesep=0.2, ranksep=0.4, splines=true, pad=0.2, fontname="Liberation Sans", labelloc=t, fontsize=14, label="Modelo conceptual - entidades y relaciones de negocio"];
  node [shape=plaintext, fontname="Liberation Sans", fontsize=10];
  edge [fontname="Liberation Sans", fontsize=8.5, color="#52514e", fontcolor="#52514e", arrowsize=0.9, dir=both];
  AEROPUERTO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD><B>AEROPUERTO</B></TD></TR></TABLE>>];
  RUTA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD><B>RUTA</B></TD></TR></TABLE>>];
  PROGRAMACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD><B>PROGRAMACION</B></TD></TR></TABLE>>];
  VUELO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD><B>VUELO</B></TD></TR></TABLE>>];
  CONFIGURACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD><B>CONFIGURACION</B></TD></TR></TABLE>>];
  AVION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD><B>AVION</B></TD></TR></TABLE>>];
  EMPLEADO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD><B>EMPLEADO</B></TD></TR></TABLE>>];
  CUPO_CABINA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD><B>CUPO CABINA</B></TD></TR></TABLE>>];
  CABINA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD><B>CABINA</B></TD></TR></TABLE>>];
  TARIFA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD><B>TARIFA</B></TD></TR></TABLE>>];
  POLITICA_CANCELACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD><B>POLITICA CANCELACION</B></TD></TR></TABLE>>];
  TIQUETE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD><B>TIQUETE</B></TD></TR></TABLE>>];
  DESCUENTO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD><B>DESCUENTO</B></TD></TR></TABLE>>];
  COMPRA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD><B>COMPRA</B></TD></TR></TABLE>>];
  PERSONA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD><B>PERSONA</B></TD></TR></TABLE>>];
  CLIENTE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD><B>CLIENTE</B></TD></TR></TABLE>>];
  LOCALIZACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD><B>LOCALIZACION</B></TD></TR></TABLE>>];
  PAGO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD><B>PAGO</B></TD></TR></TABLE>>];
  REEMBOLSO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD><B>REEMBOLSO</B></TD></TR></TABLE>>];
  AEROPUERTO -> RUTA [arrowtail=teetee, arrowhead=crowodot, label=" origen y destino de "];
  RUTA -> PROGRAMACION [arrowtail=teetee, arrowhead=crowodot, label=" se opera con "];
  PROGRAMACION -> VUELO [arrowtail=teetee, arrowhead=crowodot, label=" genera por fecha "];
  CONFIGURACION -> AVION [arrowtail=teetee, arrowhead=crowodot, label=" equipa "];
  AVION -> VUELO [arrowtail=teeodot, arrowhead=crowodot, label=" opera "];
  EMPLEADO -> VUELO [arrowtail=crowodot, arrowhead=crowodot, label=" tripula "];
  VUELO -> CUPO_CABINA [arrowtail=teetee, arrowhead=crowtee, label=" ofrece "];
  CABINA -> CUPO_CABINA [arrowtail=teetee, arrowhead=crowodot, label=" clasifica "];
  RUTA -> TARIFA [arrowtail=teetee, arrowhead=crowodot, label=" tiene "];
  CABINA -> TARIFA [arrowtail=teetee, arrowhead=crowodot, label=" diferencia "];
  CABINA -> POLITICA_CANCELACION [arrowtail=teetee, arrowhead=crowtee, label=" fija "];
  CUPO_CABINA -> TIQUETE [arrowtail=teetee, arrowhead=crowodot, label=" consume plaza "];
  TARIFA -> TIQUETE [arrowtail=teetee, arrowhead=crowodot, label=" precio base "];
  DESCUENTO -> TIQUETE [arrowtail=teeodot, arrowhead=crowodot, label=" rebaja "];
  COMPRA -> TIQUETE [arrowtail=teetee, arrowhead=crowtee, label=" incluye "];
  PERSONA -> TIQUETE [arrowtail=teetee, arrowhead=crowodot, label=" pasajero "];
  PERSONA -> COMPRA [arrowtail=teetee, arrowhead=crowodot, label=" comprador "];
  PERSONA -> CLIENTE [arrowtail=teetee, arrowhead=teeodot, label=" se registra "];
  LOCALIZACION -> COMPRA [arrowtail=teetee, arrowhead=crowodot, label=" canal de venta "];
  LOCALIZACION -> AEROPUERTO [arrowtail=teetee, arrowhead=teeodot, label=" subtipo "];
  EMPLEADO -> COMPRA [arrowtail=teeodot, arrowhead=crowodot, label=" vende "];
  TIQUETE -> PAGO [arrowtail=teetee, arrowhead=crowodot, label=" se paga con "];
  PAGO -> REEMBOLSO [arrowtail=teetee, arrowhead=crowodot, label=" se devuelve con "];
}
