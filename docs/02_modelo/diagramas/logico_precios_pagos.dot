digraph ER {
  graph [rankdir=TB, nodesep=0.2, ranksep=0.4, splines=true, pad=0.2, fontname="Liberation Sans", labelloc=t, fontsize=14, label="Modelo lógico relacional - Precios, pagos y reembolsos (3FN)"];
  node [shape=plaintext, fontname="Liberation Sans", fontsize=10];
  edge [fontname="Liberation Sans", fontsize=8.5, color="#52514e", fontcolor="#52514e", arrowsize=0.9, dir=both];
  TARIFA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>TARIFA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_tarifa</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_ruta</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">codigo_cabina</TD></TR><TR><TD></TD><TD ALIGN="LEFT">precio_base_usd</TD></TR><TR><TD></TD><TD ALIGN="LEFT">vigente_desde</TD></TR><TR><TD></TD><TD ALIGN="LEFT">vigente_hasta</TD></TR></TABLE>>];
  DESCUENTO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>DESCUENTO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_descuento</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT">codigo_descuento</TD></TR><TR><TD></TD><TD ALIGN="LEFT">porcentaje</TD></TR><TR><TD></TD><TD ALIGN="LEFT">vigente_desde</TD></TR><TR><TD></TD><TD ALIGN="LEFT">vigente_hasta</TD></TR><TR><TD></TD><TD ALIGN="LEFT">solo_clientes_registrados</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">codigo_cabina</TD></TR><TR><TD></TD><TD ALIGN="LEFT">dias_anticipacion_min</TD></TR></TABLE>>];
  POLITICA_CANCELACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>POLITICA_CANCELACION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_politica</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK UK</FONT></TD><TD ALIGN="LEFT">codigo_cabina</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT">horas_antes_min</TD></TR><TR><TD></TD><TD ALIGN="LEFT">porcentaje_reembolso</TD></TR></TABLE>>];
  PAGO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>PAGO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_pago</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_tiquete</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">codigo_metodo</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_localizacion_cobro</TD></TR><TR><TD></TD><TD ALIGN="LEFT">monto_usd</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">codigo_estado</TD></TR><TR><TD></TD><TD ALIGN="LEFT">fecha_creacion_utc</TD></TR><TR><TD></TD><TD ALIGN="LEFT">fecha_resolucion_utc</TD></TR></TABLE>>];
  REEMBOLSO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>REEMBOLSO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_reembolso</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_pago</TD></TR><TR><TD></TD><TD ALIGN="LEFT">monto_usd</TD></TR><TR><TD></TD><TD ALIGN="LEFT">fecha_reembolso_utc</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">codigo_motivo</TD></TR><TR><TD></TD><TD ALIGN="LEFT">porcentaje_aplicado</TD></TR><TR><TD></TD><TD ALIGN="LEFT">regla_aplicada</TD></TR></TABLE>>];
  TIQUETE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>TIQUETE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_tiquete</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">codigo_cabina</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_tarifa</TD></TR><TR><TD></TD><TD ALIGN="LEFT">precio_base_usd</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_descuento</TD></TR><TR><TD></TD><TD ALIGN="LEFT">porcentaje_descuento</TD></TR><TR><TD></TD><TD ALIGN="LEFT">precio_final_usd</TD></TR></TABLE>>];
  RUTA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>RUTA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_ruta</B></TD></TR></TABLE>>];
  CABINA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>CABINA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>codigo_cabina</B></TD></TR></TABLE>>];
  LOCALIZACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>LOCALIZACION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_localizacion</B></TD></TR></TABLE>>];
  TARIFA -> TIQUETE [arrowtail=teetee, arrowhead=crowodot];
  DESCUENTO -> TIQUETE [arrowtail=teeodot, arrowhead=crowodot];
  TIQUETE -> PAGO [arrowtail=teetee, arrowhead=crowodot];
  LOCALIZACION -> PAGO [arrowtail=teetee, arrowhead=crowodot];
  PAGO -> REEMBOLSO [arrowtail=teetee, arrowhead=crowodot];
  RUTA -> TARIFA [arrowtail=teetee, arrowhead=crowodot];
  CABINA -> TARIFA [arrowtail=teetee, arrowhead=crowodot];
  CABINA -> DESCUENTO [arrowtail=teeodot, arrowhead=crowodot];
  CABINA -> POLITICA_CANCELACION [arrowtail=teetee, arrowhead=crowtee];
}
