---
title: Modelo físico - Personas, compras, tiquetes, tarifas, pagos y reembolsos
---
erDiagram
    ven_persona {
    int id_persona PK "NOT NULL"
    nvarchar(60) nombres "NOT NULL"
    nvarchar(60) apellidos "NOT NULL"
    date fecha_nacimiento "NULL"
    char(1) genero "NULL"
    varchar(120) email_contacto "NULL"
    varchar(20) telefono "NULL"
    char(2) codigo_pais_nacionalidad FK "NULL"
    varchar(10) tipo_documento "NULL"
    varchar(20) numero_documento "NULL"
    char(2) codigo_pais_documento FK "NULL"
    datetime2(0) creado_utc "NOT NULL"
    }
    ven_cliente {
    int id_persona PK,FK "NOT NULL"
    char(10) numero_viajero UK "NOT NULL"
    varchar(120) email_acceso UK "NOT NULL"
    datetime2(0) fecha_registro_utc "NOT NULL"
    varchar(10) nivel_lealtad "NOT NULL"
    bit acepta_marketing "NOT NULL"
    varchar(10) estado_cuenta "NOT NULL"
    int id_aeropuerto_preferido FK "NULL"
    }
    ven_compra {
    int id_compra PK "NOT NULL"
    char(6) codigo_reserva UK "NOT NULL"
    int id_persona_comprador FK "NOT NULL"
    int id_localizacion_venta FK "NOT NULL"
    int id_empleado_vendedor FK "NULL"
    datetime2(0) fecha_compra_utc "NOT NULL"
    varchar(120) email_confirmacion "NULL"
    }
    ven_tiquete {
    int id_tiquete PK "NOT NULL"
    char(13) numero_tiquete UK "NOT NULL"
    int id_compra FK "NOT NULL"
    int id_vuelo FK,UK "NOT NULL"
    char(3) codigo_cabina FK "NOT NULL"
    int id_persona_pasajero FK,UK "NOT NULL"
    varchar(4) codigo_asiento UK "NULL"
    int id_tarifa FK "NOT NULL"
    decimal(10,2) precio_base_usd "NOT NULL"
    smallint id_descuento FK "NULL"
    decimal(5,2) porcentaje_descuento "NOT NULL"
    decimal(10,2) monto_descuento_usd "calculada"
    decimal(10,2) precio_final_usd "calculada"
    varchar(15) codigo_estado FK "NOT NULL"
    datetime2(0) fecha_limite_pago_utc "NOT NULL"
    datetime2(0) fecha_emision_utc "NULL"
    datetime2(0) fecha_cancelacion_utc "NULL"
    varchar(15) codigo_motivo_cancelacion FK "NULL"
    datetime2(0) creado_utc "NOT NULL"
    timestamp version_fila "NOT NULL"
    }
    ven_tarifa {
    int id_tarifa PK "NOT NULL"
    smallint id_ruta FK,UK "NOT NULL"
    char(3) codigo_cabina FK,UK "NOT NULL"
    decimal(10,2) precio_base_usd "NOT NULL"
    date vigente_desde UK "NOT NULL"
    date vigente_hasta "NULL"
    datetime2(0) creado_utc "NOT NULL"
    }
    ven_descuento {
    smallint id_descuento PK "NOT NULL"
    varchar(20) codigo_descuento UK "NOT NULL"
    nvarchar(150) descripcion "NOT NULL"
    decimal(5,2) porcentaje "NOT NULL"
    date vigente_desde "NOT NULL"
    date vigente_hasta "NOT NULL"
    bit solo_clientes_registrados "NOT NULL"
    char(3) codigo_cabina FK "NULL"
    smallint dias_anticipacion_min "NULL"
    bit activo "NOT NULL"
    datetime2(0) creado_utc "NOT NULL"
    }
    ven_pago {
    int id_pago PK "NOT NULL"
    int id_tiquete FK "NOT NULL"
    varchar(15) codigo_metodo FK "NOT NULL"
    int id_localizacion_cobro FK "NOT NULL"
    decimal(10,2) monto_usd "NOT NULL"
    varchar(15) codigo_estado FK "NOT NULL"
    datetime2(0) fecha_creacion_utc "NOT NULL"
    datetime2(0) fecha_resolucion_utc "NULL"
    varchar(30) referencia_autorizacion "NULL"
    char(4) ultimos4_tarjeta "NULL"
    varchar(15) marca_tarjeta "NULL"
    nvarchar(100) motivo_rechazo "NULL"
    }
    ven_reembolso {
    int id_reembolso PK "NOT NULL"
    int id_pago FK "NOT NULL"
    decimal(10,2) monto_usd "NOT NULL"
    datetime2(0) fecha_reembolso_utc "NOT NULL"
    varchar(15) codigo_motivo FK "NOT NULL"
    decimal(5,2) porcentaje_aplicado "NOT NULL"
    varchar(20) regla_aplicada "NOT NULL"
    varchar(30) referencia "NULL"
    }
    ven_politica_cancelacion {
    smallint id_politica PK "NOT NULL"
    char(3) codigo_cabina FK,UK "NOT NULL"
    smallint horas_antes_min UK "NOT NULL"
    decimal(5,2) porcentaje_reembolso "NOT NULL"
    }
    ref_metodo_pago {
    varchar(15) codigo_metodo PK "NOT NULL"
    nvarchar(40) nombre UK "NOT NULL"
    bit es_tarjeta "NOT NULL"
    bit permite_web "NOT NULL"
    bit permite_fisico "NOT NULL"
    }
    ref_estado_tiquete {
    varchar(15) codigo_estado PK "NOT NULL"
    nvarchar(100) descripcion "NOT NULL"
    bit es_estado_inicial "NOT NULL"
    bit es_final "NOT NULL"
    bit ocupa_inventario "NOT NULL"
    }
    ref_estado_pago {
    varchar(15) codigo_estado PK "NOT NULL"
    nvarchar(100) descripcion "NOT NULL"
    bit es_estado_inicial "NOT NULL"
    bit es_final "NOT NULL"
    bit es_cobro "NOT NULL"
    }
    ref_motivo_cancelacion {
    varchar(15) codigo_motivo PK "NOT NULL"
    nvarchar(150) descripcion "NOT NULL"
    varchar(10) iniciado_por "NOT NULL"
    bit reembolso_total "NOT NULL"
    }
    ref_pais {
    char(2) codigo_pais PK "NOT NULL"
    nvarchar(60) nombre UK "NOT NULL"
    }
    ops_vuelo_cabina {
    int id_vuelo PK,FK "NOT NULL"
    char(3) codigo_cabina PK,FK "NOT NULL"
    smallint capacidad "NOT NULL"
    smallint plazas_ocupadas "NOT NULL"
    }
    ops_ruta {
    smallint id_ruta PK "NOT NULL"
    int id_aeropuerto_origen FK,UK "NOT NULL"
    int id_aeropuerto_destino FK,UK "NOT NULL"
    smallint distancia_millas "NOT NULL"
    bit activa "NOT NULL"
    date fecha_inicio_operacion "NULL"
    datetime2(0) creado_utc "NOT NULL"
    }
    ref_localizacion {
    int id_localizacion PK "NOT NULL"
    varchar(12) codigo_localizacion UK "NOT NULL"
    char(3) tipo_localizacion UK "NOT NULL"
    nvarchar(100) nombre "NOT NULL"
    nvarchar(60) ciudad "NULL"
    char(2) codigo_estado FK "NULL"
    nvarchar(150) direccion "NULL"
    varchar(10) codigo_postal "NULL"
    varchar(50) zona_horaria FK "NULL"
    varchar(200) url UK "NULL"
    bit vende_tiquetes "NOT NULL"
    bit activa "NOT NULL"
    date fecha_apertura "NOT NULL"
    datetime2(0) creado_utc "NOT NULL"
    }
    rh_empleado {
    int id_empleado PK "NOT NULL"
    char(6) numero_empleado UK "NOT NULL"
    nvarchar(60) nombres "NOT NULL"
    nvarchar(60) apellidos "NOT NULL"
    date fecha_nacimiento "NOT NULL"
    varchar(120) email_corporativo UK "NOT NULL"
    varchar(20) telefono "NULL"
    date fecha_contratacion "NOT NULL"
    date fecha_terminacion "NULL"
    varchar(15) codigo_cargo FK "NOT NULL"
    int id_localizacion_base FK "NOT NULL"
    int id_supervisor FK "NULL"
    decimal(12,2) salario_anual_usd "NOT NULL"
    datetime2(0) creado_utc "NOT NULL"
    }
    ref_cabina {
    char(3) codigo_cabina PK "NOT NULL"
    nvarchar(40) nombre UK "NOT NULL"
    nvarchar(200) descripcion "NOT NULL"
    tinyint piezas_equipaje_bodega "NOT NULL"
    tinyint peso_max_equipaje_kg "NOT NULL"
    bit acceso_sala_vip "NOT NULL"
    tinyint orden_abordaje UK "NOT NULL"
    }
    ven_persona ||--o| ven_cliente : "fk_cliente_persona"
    ven_persona ||--o{ ven_compra : "fk_compra_comprador"
    ref_localizacion ||--o{ ven_compra : "fk_compra_localizacion"
    rh_empleado |o--o{ ven_compra : "fk_compra_vendedor"
    ref_cabina |o--o{ ven_descuento : "fk_descuento_cabina"
    ref_localizacion ||--o{ rh_empleado : "fk_empleado_localizacion"
    rh_empleado |o--o{ rh_empleado : "fk_empleado_supervisor"
    ref_estado_pago ||--o{ ven_pago : "fk_pago_estado"
    ref_localizacion ||--o{ ven_pago : "fk_pago_localizacion"
    ref_metodo_pago ||--o{ ven_pago : "fk_pago_metodo"
    ven_tiquete ||--o{ ven_pago : "fk_pago_tiquete"
    ref_pais |o--o{ ven_persona : "fk_persona_pais_documento"
    ref_pais |o--o{ ven_persona : "fk_persona_pais_nacionalidad"
    ref_cabina ||--o{ ven_politica_cancelacion : "fk_politica_cabina"
    ref_motivo_cancelacion ||--o{ ven_reembolso : "fk_reembolso_motivo"
    ven_pago ||--o{ ven_reembolso : "fk_reembolso_pago"
    ref_cabina ||--o{ ven_tarifa : "fk_tarifa_cabina"
    ops_ruta ||--o{ ven_tarifa : "fk_tarifa_ruta"
    ven_compra ||--o{ ven_tiquete : "fk_tiquete_compra"
    ven_descuento |o--o{ ven_tiquete : "fk_tiquete_descuento"
    ref_estado_tiquete ||--o{ ven_tiquete : "fk_tiquete_estado"
    ref_motivo_cancelacion |o--o{ ven_tiquete : "fk_tiquete_motivo"
    ven_persona ||--o{ ven_tiquete : "fk_tiquete_pasajero"
    ven_tarifa ||--o{ ven_tiquete : "fk_tiquete_tarifa_cabina"
    ops_vuelo_cabina ||--o{ ven_tiquete : "fk_tiquete_vuelo_cabina"
    ref_cabina ||--o{ ops_vuelo_cabina : "fk_vuelo_cabina_cabina"
