---
title: Modelo físico - Red, flota, vuelos y tripulación
---
erDiagram
    ref_localizacion {
    int id_localizacion PK "NOT NULL"
    varchar(12) codigo_localizacion UK "NOT NULL"
    char(3) tipo_localizacion UK "NOT NULL"
    nvarchar(100) nombre "NOT NULL"
    nvarchar(60) ciudad "NULL"
