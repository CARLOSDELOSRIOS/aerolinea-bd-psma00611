    bit activa "NOT NULL"
    date fecha_apertura "NOT NULL"
    datetime2(0) creado_utc "NOT NULL"
    }
    ref_aeropuerto {
    int id_localizacion PK,FK "NOT NULL"
    char(3) tipo_localizacion FK "calculada"
    char(3) codigo_iata UK "NOT NULL"
