digraph ER {
  graph [rankdir=TB, nodesep=0.2, ranksep=0.4, splines=true, pad=0.2, fontname="Liberation Sans", labelloc=t, fontsize=14, label="Modelo lógico relacional - Red, horarios y vuelos (3FN)"];
  node [shape=plaintext, fontname="Liberation Sans", fontsize=10];
  edge [fontname="Liberation Sans", fontsize=8.5, color="#52514e", fontcolor="#52514e", arrowsize=0.9, dir=both];
  ZONA_HORARIA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>ZONA_HORARIA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>nombre_windows</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT">nombre_iana</TD></TR><TR><TD></TD><TD ALIGN="LEFT">observa_horario_verano</TD></TR></TABLE>>];
  LOCALIZACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>LOCALIZACION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_localizacion</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT">codigo_localizacion</TD></TR><TR><TD></TD><TD ALIGN="LEFT">tipo_localizacion</TD></TR><TR><TD></TD><TD ALIGN="LEFT">nombre</TD></TR><TR><TD></TD><TD ALIGN="LEFT">ciudad</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">codigo_estado</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">zona_horaria</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT">url</TD></TR><TR><TD></TD><TD ALIGN="LEFT">vende_tiquetes</TD></TR></TABLE>>];
  AEROPUERTO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>AEROPUERTO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_localizacion</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">tipo_localizacion</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT">codigo_iata</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT">codigo_icao</TD></TR><TR><TD></TD><TD ALIGN="LEFT">latitud</TD></TR><TR><TD></TD><TD ALIGN="LEFT">longitud</TD></TR></TABLE>>];
  RUTA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>RUTA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_ruta</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK UK</FONT></TD><TD ALIGN="LEFT">id_aeropuerto_origen</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK UK</FONT></TD><TD ALIGN="LEFT">id_aeropuerto_destino</TD></TR><TR><TD></TD><TD ALIGN="LEFT">distancia_millas</TD></TR><TR><TD></TD><TD ALIGN="LEFT">activa</TD></TR></TABLE>>];
  PROGRAMACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>PROGRAMACION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_programacion</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT">numero_vuelo</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_ruta</TD></TR><TR><TD></TD><TD ALIGN="LEFT">hora_salida_local</TD></TR><TR><TD></TD><TD ALIGN="LEFT">duracion_programada_min</TD></TR><TR><TD></TD><TD ALIGN="LEFT">vigente_desde</TD></TR><TR><TD></TD><TD ALIGN="LEFT">vigente_hasta</TD></TR></TABLE>>];
  PROGRAMACION_DIA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>PROGRAMACION_DIA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_programacion</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>dia_semana</B></TD></TR></TABLE>>];
  VUELO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>VUELO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_vuelo</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK UK</FONT></TD><TD ALIGN="LEFT">id_programacion</TD></TR><TR><TD></TD><TD ALIGN="LEFT">salida_programada</TD></TR><TR><TD></TD><TD ALIGN="LEFT">llegada_programada</TD></TR><TR><TD></TD><TD ALIGN="LEFT">fecha_salida_local</TD></TR><TR><TD></TD><TD ALIGN="LEFT">salida_estimada</TD></TR><TR><TD></TD><TD ALIGN="LEFT">salida_real</TD></TR><TR><TD></TD><TD ALIGN="LEFT">llegada_real</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_avion</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">codigo_estado</TD></TR></TABLE>>];
  VUELO_CABINA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>VUELO_CABINA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_vuelo</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>codigo_cabina</B></TD></TR><TR><TD></TD><TD ALIGN="LEFT">capacidad</TD></TR><TR><TD></TD><TD ALIGN="LEFT">plazas_ocupadas</TD></TR></TABLE>>];
  CABINA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>CABINA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>codigo_cabina</B></TD></TR><TR><TD></TD><TD ALIGN="LEFT">nombre</TD></TR></TABLE>>];
  LOCALIZACION -> AEROPUERTO [arrowtail=teetee, arrowhead=teeodot];
  ZONA_HORARIA -> LOCALIZACION [arrowtail=teetee, arrowhead=crowodot];
  AEROPUERTO -> RUTA [arrowtail=teetee, arrowhead=crowodot];
  AEROPUERTO -> RUTA [arrowtail=teetee, arrowhead=crowodot];
  RUTA -> PROGRAMACION [arrowtail=teetee, arrowhead=crowodot];
  PROGRAMACION -> PROGRAMACION_DIA [arrowtail=teetee, arrowhead=crowtee];
  PROGRAMACION -> VUELO [arrowtail=teetee, arrowhead=crowodot];
  VUELO -> VUELO_CABINA [arrowtail=teetee, arrowhead=crowtee];
  CABINA -> VUELO_CABINA [arrowtail=teetee, arrowhead=crowodot];
}
