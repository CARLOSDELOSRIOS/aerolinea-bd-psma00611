digraph ER {
  graph [rankdir=TB, nodesep=0.2, ranksep=0.4, splines=true, pad=0.2, fontname="Liberation Sans", labelloc=t, fontsize=14, label="Modelo lógico relacional - Personas, compras y tiquetes (3FN)"];
  node [shape=plaintext, fontname="Liberation Sans", fontsize=10];
  edge [fontname="Liberation Sans", fontsize=8.5, color="#52514e", fontcolor="#52514e", arrowsize=0.9, dir=both];
  PERSONA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>PERSONA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_persona</B></TD></TR><TR><TD></TD><TD ALIGN="LEFT">nombres</TD></TR><TR><TD></TD><TD ALIGN="LEFT">apellidos</TD></TR><TR><TD></TD><TD ALIGN="LEFT">fecha_nacimiento</TD></TR><TR><TD></TD><TD ALIGN="LEFT">tipo_documento</TD></TR><TR><TD></TD><TD ALIGN="LEFT">numero_documento</TD></TR><TR><TD></TD><TD ALIGN="LEFT">email_contacto</TD></TR></TABLE>>];
  CLIENTE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>CLIENTE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_persona</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT">numero_viajero</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT">email_acceso</TD></TR><TR><TD></TD><TD ALIGN="LEFT">fecha_registro_utc</TD></TR><TR><TD></TD><TD ALIGN="LEFT">nivel_lealtad</TD></TR></TABLE>>];
  COMPRA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>COMPRA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_compra</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT">codigo_reserva</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_persona_comprador</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_localizacion_venta</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_empleado_vendedor</TD></TR><TR><TD></TD><TD ALIGN="LEFT">fecha_compra_utc</TD></TR></TABLE>>];
  TIQUETE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>TIQUETE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_tiquete</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">UK</FONT></TD><TD ALIGN="LEFT">numero_tiquete</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_compra</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_vuelo</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">codigo_cabina</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_persona_pasajero</TD></TR><TR><TD></TD><TD ALIGN="LEFT">codigo_asiento</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_tarifa</TD></TR><TR><TD></TD><TD ALIGN="LEFT">precio_base_usd</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">id_descuento</TD></TR><TR><TD></TD><TD ALIGN="LEFT">porcentaje_descuento</TD></TR><TR><TD></TD><TD ALIGN="LEFT">precio_final_usd</TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FK</FONT></TD><TD ALIGN="LEFT">codigo_estado</TD></TR><TR><TD></TD><TD ALIGN="LEFT">fecha_limite_pago_utc</TD></TR></TABLE>>];
  VUELO_CABINA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>VUELO_CABINA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_vuelo</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>codigo_cabina</B></TD></TR></TABLE>>];
  LOCALIZACION [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>LOCALIZACION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_localizacion</B></TD></TR></TABLE>>];
  EMPLEADO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>EMPLEADO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_empleado</B></TD></TR></TABLE>>];
  TARIFA [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>TARIFA</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_tarifa</B></TD></TR></TABLE>>];
  DESCUENTO [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#52514e" BGCOLOR="#ffffff"><TR><TD COLSPAN="2" BGCOLOR="#256abf"><FONT COLOR="#ffffff"><B>DESCUENTO</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><FONT POINT-SIZE="9">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fa"><B>id_descuento</B></TD></TR></TABLE>>];
  PERSONA -> CLIENTE [arrowtail=teetee, arrowhead=teeodot];
  PERSONA -> COMPRA [arrowtail=teetee, arrowhead=crowodot];
  PERSONA -> TIQUETE [arrowtail=teetee, arrowhead=crowodot];
  LOCALIZACION -> COMPRA [arrowtail=teetee, arrowhead=crowodot];
  EMPLEADO -> COMPRA [arrowtail=teeodot, arrowhead=crowodot];
  COMPRA -> TIQUETE [arrowtail=teetee, arrowhead=crowtee];
  VUELO_CABINA -> TIQUETE [arrowtail=teetee, arrowhead=crowodot];
  TARIFA -> TIQUETE [arrowtail=teetee, arrowhead=crowodot];
  DESCUENTO -> TIQUETE [arrowtail=teeodot, arrowhead=crowodot];
}
