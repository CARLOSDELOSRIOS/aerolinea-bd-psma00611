# Copie este archivo como .env y ajústelo. .env NO se sube al repositorio.
# ---------------------------------------------------------------------------
# Instancia local en la laptop (instancia predeterminada MSSQLSERVER)
DB_SERVER=localhost
DB_DATABASE=AerolineaDB
# windows | sql | entra_interactivo | entra_token
DB_AUTH=windows
# Controlador ODBC: vacío = autodetección (ODBC Driver 18 y, si no está, 17)
DB_DRIVER=
# El cifrado se mantiene siempre activo
DB_ENCRYPT=yes
# SOLO para la instancia local con certificado autofirmado (ver docs/04_entorno_local).
# Nunca "yes" con Azure: la aplicación lo rechaza.
DB_TRUST_SERVER_CERTIFICATE=yes
# Solo con DB_AUTH=sql. La contraseña NO se escribe aquí: defina la variable de
# entorno DB_PASSWORD en la sesión o deje que la aplicación la pida.
DB_USER=
# Segundos de espera para iniciar sesión
DB_TIMEOUT=30
