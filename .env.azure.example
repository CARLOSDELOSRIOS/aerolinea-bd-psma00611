# Copie como .env.azure (NO se sube al repositorio) y úselo con:  python -m aerolinea --env .env.azure <comando>
DB_SERVER=<nombre-unico>.database.windows.net
DB_DATABASE=AerolineaDB
# entra_interactivo: abre el inicio de sesión de Microsoft Entra (MFA) en el navegador
# entra_token: usa azure-identity (pip install -r requirements-azure.txt; p. ej., tras "az login")
DB_AUTH=entra_interactivo
DB_USER=<usuario@dominio>
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
# Obligatorio en Azure: validar el certificado del servidor
DB_TRUST_SERVER_CERTIFICATE=no
DB_TIMEOUT=60
