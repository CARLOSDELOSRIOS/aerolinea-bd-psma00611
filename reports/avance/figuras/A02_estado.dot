 t [shape=plain, style="", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD ALIGN="LEFT" BGCOLOR="#256ABF"><B><FONT COLOR="white">Componente</FONT></B></TD><TD ALIGN="LEFT" BGCOLOR="#256ABF"><B><FONT COLOR="white">Qué tenemos</FONT></B></TD><TD BGCOLOR="#256ABF"><B><FONT COLOR="white">Estado</FONT></B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><B>Requisitos de la empresa</B></TD><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT COLOR="#52514e">42 reglas, 13 supuestos, 13 casos de uso</FONT></TD><TD BGCOLOR="#F6F8FC"><TABLE BORDER="1" COLOR="#0ca30c" CELLBORDER="0" CELLPADDING="3" BGCOLOR="#E7F6E7" STYLE="rounded"><TR><TD><FONT FACE="DejaVu Sans" POINT-SIZE="9" COLOR="#0ca30c"><B>✔ Completo</B></FONT></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>Modelo de datos</B></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">Conceptual, lógico y físico en 3FN; 269 columnas documentadas</FONT></TD><TD BGCOLOR="white"><TABLE BORDER="1" COLOR="#0ca30c" CELLBORDER="0" CELLPADDING="3" BGCOLOR="#E7F6E7" STYLE="rounded"><TR><TD><FONT FACE="DejaVu Sans" POINT-SIZE="9" COLOR="#0ca30c"><B>✔ Completo</B></FONT></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><B>Creación de tablas</B></TD><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT COLOR="#52514e">Scripts 01 a 13 probados en el entorno de desarrollo</FONT></TD><TD BGCOLOR="#F6F8FC"><TABLE BORDER="1" COLOR="#0ca30c" CELLBORDER="0" CELLPADDING="3" BGCOLOR="#E7F6E7" STYLE="rounded"><TR><TD><FONT FACE="DejaVu Sans" POINT-SIZE="9" COLOR="#0ca30c"><B>✔ Completo</B></FONT></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>Inserción de datos</B></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">Catálogos y ≈1,19 millones de filas sintéticas</FONT></TD><TD BGCOLOR="white"><TABLE BORDER="1" COLOR="#0ca30c" CELLBORDER="0" CELLPADDING="3" BGCOLOR="#E7F6E7" STYLE="rounded"><TR><TD><FONT FACE="DejaVu Sans" POINT-SIZE="9" COLOR="#0ca30c"><B>✔ Completo</B></FONT></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><B>Consultas</B></TD><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT COLOR="#52514e">20 consultas con resultado e interpretación</FONT></TD><TD BGCOLOR="#F6F8FC"><TABLE BORDER="1" COLOR="#0ca30c" CELLBORDER="0" CELLPADDING="3" BGCOLOR="#E7F6E7" STYLE="rounded"><TR><TD><FONT FACE="DejaVu Sans" POINT-SIZE="9" COLOR="#0ca30c"><B>✔ Completo</B></FONT></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>Consultas desde Python</B></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">pyodbc y pandas, con parámetros enlazados</FONT></TD><TD BGCOLOR="white"><TABLE BORDER="1" COLOR="#0ca30c" CELLBORDER="0" CELLPADDING="3" BGCOLOR="#E7F6E7" STYLE="rounded"><TR><TD><FONT FACE="DejaVu Sans" POINT-SIZE="9" COLOR="#0ca30c"><B>✔ Completo</B></FONT></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><B>Repositorio en GitHub</B></TD><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT COLOR="#52514e">Proyecto y scripts subidos; falta sumar colaboradores</FONT></TD><TD BGCOLOR="#F6F8FC"><TABLE BORDER="1" COLOR="#B07A00" CELLBORDER="0" CELLPADDING="3" BGCOLOR="#FFF4D6" STYLE="rounded"><TR><TD><FONT FACE="DejaVu Sans" POINT-SIZE="9" COLOR="#B07A00"><B>◐ En curso</B></FONT></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><B>Ejecución en las laptops</B></TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">Guía y script de verificación listos</FONT></TD><TD BGCOLOR="white"><TABLE BORDER="1" COLOR="#d03b3b" CELLBORDER="0" CELLPADDING="3" BGCOLOR="#FBE9E9" STYLE="rounded"><TR><TD><FONT FACE="DejaVu Sans" POINT-SIZE="9" COLOR="#d03b3b"><B>○ Pendiente</B></FONT></TD></TR></TABLE></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><B>Base de datos en Azure</B></TD><TD ALIGN="LEFT" BGCOLOR="#F6F8FC"><FONT COLOR="#52514e">Guía y scripts listos; sin desplegar</FONT></TD><TD BGCOLOR="#F6F8FC"><TABLE BORDER="1" COLOR="#d03b3b" CELLBORDER="0" CELLPADDING="3" BGCOLOR="#FBE9E9" STYLE="rounded"><