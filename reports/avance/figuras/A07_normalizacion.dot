digraph G {
 graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.5, ranksep=0.45, fontname="Liberation Sans", fontsize=11, newrank=true];
 node [fontname="Liberation Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor="#EEF3FA", color="#9EB6D8", fontcolor="#0b0b0b", penwidth=1.2, margin="0.18,0.10"];
 edge [fontname="Liberation Sans", fontsize=9.5, color="#52514e", fontcolor="#52514e", arrowsize=0.75];

 p0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#A33333">Punto de partida: una planilla de ventas</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">Pagos y reembolsos como listas</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">Horario repetido en cada fila</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">Comprador y pasajero mezclados</FONT></TD></TR></TABLE>>, fillcolor="#FBE9E9", color="#E5B5B5"];
 p1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1F3864">1FN · valores atómicos</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">Pagos, reembolsos y días de operación</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">pasan a tablas propias</FONT></TD></TR></TABLE>>];
 p2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1F3864">2FN · sin dependencias parciales</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">Cada dato depende de toda la clave:</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">el nombre del tripulante vive en</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">rh.empleado, no en la asignación</FONT></TD></TR></TABLE>>];
 p3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1F3864">3FN · sin dependencias transitivas</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">tiquete → vuelo → programación</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">→ ruta → aeropuerto, cada uno</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">en su propia tabla</FONT></TD></TR></TABLE>>, fillcolor="#E7F6E7", color="#9FD49F"];
 {rank=same; p0 -> p1;} {rank=same; p2 -> p3;} p1 -> p2; p0 -> p2 [style=invis];
 r [shape=note, fillcolor="#FFFDF5", color="#D9C9A3", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#7A5C00">6 redundancias controladas</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">La principal: el tiquete guarda su precio de venta.</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">Un trigger comprueba la copia y la vuelve inmutable.</FONT></TD></TR></TABLE>>];
 p3 -> r [style=dashed, arrowhead=none];
}
