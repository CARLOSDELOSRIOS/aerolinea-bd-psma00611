digraph G {
 graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.3, ranksep=0.45, fontname="Liberation Sans", fontsize=11, newrank=true];
 node [fontname="Liberation Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor="#EEF3FA", color="#9EB6D8", fontcolor="#0b0b0b", penwidth=1.2, margin="0.18,0.10"];
 edge [fontname="Liberation Sans", fontsize=9.5, color="#52514e", fontcolor="#52514e", arrowsize=0.75];
 subgraph cluster_d { label=<<B>Entorno de desarrollo · contenedor con SQL Server 2022</B>>; fontcolor="#1F3864"; style="rounded"; color="#9EB6D8"; bgcolor="#F6F8FC";
 a [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><B><FONT COLOR="#1F3864">Aplicación (pytest)</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9.5" COLOR="#52514e">23 de 23</FONT></TD></TR><TR><TD><TABLE BORDER="1" COLOR="#0ca30c" CELLBORDER="0" CELLPADDING="3" BGCOLOR="#E7F6E7" STYLE="rounded"><TR><TD><FONT FACE="DejaVu Sans" POINT-SIZE="9" COLOR="#0ca30c"><B>✔ Completo</B></FONT></TD></TR></TABLE></TD></TR></TABLE>>, fillcolor="white", width=2.6];
 b [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><B><FONT COLOR="#1F3864">Reglas de negocio</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9.5" COLOR="#52514e">23 de 23 (PR)</FONT></TD></TR><TR><TD><TABLE BORDER="1" COLOR="#0ca30c" CELLBORDER="0" CELLPADDING="3" BGCOLOR="#E7F6E7" STYLE="rounded"><TR><TD><FONT FACE="DejaVu Sans" POINT-SIZE="9" COLOR="#0ca30c"><B>✔ Completo</B></FONT></TD></TR></TABLE></TD></TR></TABLE>>, fillcolor="white", width=2.6];
 c [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><B><FONT COLOR="#1F3864">Concurrencia real</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9.5" COLOR="#52514e">4 de 4 (PC)</FONT></TD></TR><TR><TD><TABLE BORDER="1" COLOR="#0ca30c" CELLBORDER="0" CELLPADDING="3" BGCOLOR="#E7F6E7" STYLE="rounded"><TR><TD><FONT FACE="DejaVu Sans" POINT-SIZE="9" COLOR="#0ca30c"><B>✔ Completo</B></FONT></TD></TR></TABLE></TD></TR></TABLE>>, fillcolor="white", width=2.6];
 d [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><B><FONT COLOR="#1F3864">Compatibilidad SQL Server 2016</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9.5" COLOR="#52514e">27 de 27 con nivel 130</FONT></TD></TR><TR><TD><TABLE BORDER="1" COLOR="#0ca30c" CELLBORDER="0" CELLPADDING="3" BGCOLOR="#E7F6E7" STYLE="rounded"><TR><TD><FONT FACE="DejaVu Sans" POINT-SIZE="9" COLOR="#0ca30c"><B>✔ Completo</B></FONT></TD></TR></TABLE></TD></TR></TABLE>>, fillcolor="white", width=2.6];
  {rank=same; a; b;} {rank=same; c; d;} a -> c [style=invis]; b -> d [style=invis];
 }
 subgraph cluster_r { label=<<B>Entornos reales del encargo</B>>; fontcolor="#1F3864"; style="rounded,dashed"; color="#E5B5B5";
 e [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><B><FONT COLOR="#1F3864">Laptops del equipo</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9.5" COLOR="#52514e">Windows · SQL Server local</FONT></TD></TR><TR><TD><TABLE BORDER="1" COLOR="#d03b3b" CELLBORDER="0" CELLPADDING="3" BGCOLOR="#FBE9E9" STYLE="rounded"><TR><TD><FONT FACE="DejaVu Sans" POINT-SIZE="9" COLOR="#d03b3b"><B>○ Pendiente</B></FONT></TD></TR></TABLE></TD></TR></TABLE>>, fillcolor="white", width=2.6];
 f [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><B><FONT COLOR="#1F3864">Azure SQL Database</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9.5" COLOR="#52514e">Requisito de nube</FONT></TD></TR><TR><TD><TABLE BORDER="1" COLOR="#d03b3b" CELLBORDER="0" CELLPADDING="3" BGCOLOR="#FBE9E9" STYLE="rounded"><TR><TD><FONT FACE="DejaVu Sans" POINT-SIZE="9" COLOR="#d03b3b"><B>○ Pendiente</B></FONT></TD></TR></TABLE></TD></TR></TABLE>>, fillcolor="white", width=2.6];
  {rank=same; e; f;}
 }
 c -> e [style=dashed, label=" siguiente paso"]; d -> f [style=invis];
}
