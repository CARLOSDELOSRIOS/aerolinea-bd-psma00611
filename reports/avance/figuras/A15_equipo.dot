digraph G {
 graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.5, ranksep=0.5, fontname="Liberation Sans", fontsize=11, newrank=true];
 node [fontname="Liberation Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor="#EEF3FA", color="#9EB6D8", fontcolor="#0b0b0b", penwidth=1.2, margin="0.18,0.10"];
 edge [fontname="Liberation Sans", fontsize=9.5, color="#52514e", fontcolor="#52514e", arrowsize=0.75];
 subgraph cluster_e { label=<<B>Equipo · los tres en todas las etapas</B>>; fontcolor="#1F3864"; style="rounded"; color="#9EB6D8"; bgcolor="#F6F8FC";
  i0 [label="Carlos Veliz de Villa Aguirre", fillcolor="white"];
  i1 [label="Elias Sifuentes Valles", fillcolor="white"];
  i2 [label="Carlos De los Ríos De la Roca\n(líder)", fillcolor="white"];
  {rank=same; i0; i1; i2;}
 }
 p [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1F3864">1. Redactamos juntos el prompt</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">Qué pedir, con qué reglas</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">y qué no se debe inventar</FONT></TD></TR></TABLE>>];
 c [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1F3864">2. Claude Code genera y ejecuta</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">Archivos, scripts, pruebas</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">y documentos</FONT></TD></TR></TABLE>>, fillcolor="#FFF4D6", color="#E3C77A"];
 r [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1F3864">3. Revisamos juntos el resultado</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">Cifras, decisiones, pendientes</FONT></TD></TR></TABLE>>];
 g [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1F3864">4. GitHub</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">Repositorio e historial</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">de versiones</FONT></TD></TR></TABLE>>, fillcolor="#E7F6E7", color="#9FD49F"];
 {rank=same; p -> c;} {rank=same; g -> r [dir=back];} c -> r; p -> g [style=invis];
 r -> p [label=" ajustes", style=dashed, constraint=false];
 i0 -> p; i1 -> p; i2 -> p;
 n [shape=note, fillcolor="white", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1F3864">Evidencia</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">Prompts literales: anexo B</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">Historial de cambios: GitHub</FONT></TD></TR></TABLE>>]; g -> n [style=dashed, arrowhead=none];
}
