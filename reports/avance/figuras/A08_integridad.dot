digraph G {
 graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.8, ranksep=0.4, fontname="Liberation Sans", fontsize=11, newrank=true];
 node [fontname="Liberation Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor="#EEF3FA", color="#9EB6D8", fontcolor="#0b0b0b", penwidth=1.2, margin="0.18,0.10"];
 edge [fontname="Liberation Sans", fontsize=9.5, color="#52514e", fontcolor="#52514e", arrowsize=0.75];

 entra [label="Dato que llega (aplicación, SSMS o carga masiva)", fillcolor="white"];
 capas [shape=plain, style="", label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="4" CELLPADDING="8" COLOR="#9EB6D8"><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#DCE8F7" WIDTH="430"><B><FONT COLOR="#1F3864">1. Restricciones declarativas</FONT></B><BR ALIGN="LEFT"/><FONT POINT-SIZE="9.5" COLOR="#52514e">70 CHECK · 53 claves foráneas · 29 UNIQUE · 6 índices únicos filtrados</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#E6EEF9" WIDTH="430"><B><FONT COLOR="#1F3864">2. Triggers</FONT></B><BR ALIGN="LEFT"/><FONT POINT-SIZE="9.5" COLOR="#52514e">12 triggers: estados, solapes de avión y tripulación, inventario, precio inmutable</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#EFF4FB" WIDTH="430"><B><FONT COLOR="#1F3864">3. Procedimientos almacenados</FONT></B><BR ALIGN="LEFT"/><FONT POINT-SIZE="9.5" COLOR="#52514e">16 procedimientos: emitir, pagar, cancelar, generar vuelos</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#F7F9FD" WIDTH="430"><B><FONT COLOR="#1F3864">4. Controles por consulta</FONT></B><BR ALIGN="LEFT"/><FONT POINT-SIZE="9.5" COLOR="#52514e">Conciliación de inventario y de caja (Q19)</FONT></TD></TR></TABLE>>];
 tabla [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#1F3864">Tablas</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">Solo guardan datos que</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">cumplen las 42 reglas</FONT></TD></TR></TABLE>>, fillcolor="#E7F6E7", color="#9FD49F"];
 rechazo [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="1" CELLPADDING="1"><TR><TD ALIGN="LEFT"><B><FONT COLOR="#A33333">Rechazado</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">Mensaje de negocio</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9.5" COLOR="#52514e">(errores 50000 en adelante)</FONT></TD></TR></TABLE>>, fillcolor="#FBE9E9", color="#E5B5B5"];
 entra -> capas; capas -> tabla [label=" cumple"]; capas -> rechazo [style=dashed, label=" viola una regla"];
}
